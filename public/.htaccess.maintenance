# ============================================================
# .htaccess MAINTENANCE — Crabitan Bellevue
# Déployé temporairement pendant le déploiement prod.
# Remplacé par le .htaccess normal à la fin du deploy.
# ============================================================

# ErrorDocument doit être déclaré AVANT la règle qui renvoie 503
ErrorDocument 503 /maintenance.html

RewriteEngine On

# HTTPS redirect conservé (SEO + sécurité) — 301 avant le 503
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Bypass maintenance pour IP admin
RewriteCond %{REMOTE_ADDR} ^90\.5\.222\.193$
RewriteRule .* - [L]

# Garde-fou anti-boucle : si on est déjà dans une réponse 503 servie par
# ErrorDocument, ne pas rejouer la règle (sinon Apache boucle)
RewriteCond %{ENV:REDIRECT_STATUS} ^$

# Autorise l'accès à maintenance.html, favicon et assets statiques
RewriteCond %{REQUEST_URI} !^/maintenance\.html$
RewriteCond %{REQUEST_URI} !^/favicon\.ico$
RewriteCond %{REQUEST_URI} !\.(png|jpe?g|gif|svg|css|js|woff2?|ttf|eot|ico)$ [NC]

# Envoie 503 (pas de cible → ErrorDocument prend le relais)
RewriteRule .* - [R=503,L]

# Retry-After pour les crawlers (30 min)
<IfModule mod_headers.c>
    Header always set Retry-After "1800"
    Header always set Cache-Control "no-store, no-cache, must-revalidate"

    # Security headers — réplique du .htaccess principal (le middleware PHP ne s'exécute pas ici)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-site"
    # CSP statique : page purement HTML/CSS/JS inline, aucune ressource externe
    # 'unsafe-inline' acceptable — fichier statique, pas d'input utilisateur, XSS impossible
    Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'"
</IfModule>
