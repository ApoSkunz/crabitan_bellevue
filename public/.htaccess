Options -Indexes

RewriteEngine On

# ---- HTTPS redirect ----------------------------------------------------------
RewriteCond %{HTTP_HOST} ^(www\.)?crabitanbellevue\.fr$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# -----------------------------------------------------------------------------

# ---- Mode maintenance -------------------------------------------------------
# Pour activer : décommenter les 5 lignes RewriteCond/Rule ci-dessous.
# Remplacer l'IP par la tienne (vérifier sur https://ifconfig.me avant d'activer).
# ---- Activer maintenance (décommenter) ----
# RewriteCond %{REQUEST_URI} !^/maintenance\.php$
# RewriteCond %{REQUEST_URI} !^/assets/
# RewriteCond %{REMOTE_ADDR} !^203\.0\.113\.42$
# RewriteRule ^(.*)$ /maintenance.php [R=302,L]
# ---- /Mode maintenance -------------------------------------------------------

# Redirige tout vers index.php sauf fichiers/dossiers existants
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# ---- Headers de sécurité HTTP ----
# X-Frame-Options intentionnellement redondant avec CSP frame-ancestors pour compatibilité navigateurs anciens (VULN-013)
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Permitted-Cross-Domain-Policies "none"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# HSTS — uniquement sur HTTPS (env=HTTPS non défini sur HTTP → header absent en local)
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
