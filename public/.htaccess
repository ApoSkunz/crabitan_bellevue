Options -Indexes

RewriteEngine On
RewriteBase /

# ---- HTTPS redirect (domaine prod uniquement — sans effet sur crabitan.local) ----
# Ces lignes sont commentées en local. build-prod.sh les décommente automatiquement
# dans le livrable build/prod/ via patch_htaccess(). deploy-prod.sh vérifie ensuite
# que la redirection est active avant de lancer le mirror SFTP.
# RewriteCond %{HTTP_HOST} ^(www\.)?crabitanbellevue\.fr$ [NC]
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# ---------------------------------------------------------------------------------

# ---- Mode maintenance -------------------------------------------------------
# La page maintenance.html + .htaccess.maintenance sont versionnés dans public/.
# deploy-prod.sh upload .htaccess.maintenance → .htaccess pendant le deploy,
# puis restaure ce .htaccess à la fin (désactivation automatique).
#
# Hors maintenance : un appel direct à /maintenance.html ou /.htaccess.maintenance
# n'a pas de sens → on redirige vers l'accueil.
RewriteRule ^maintenance\.html$ / [R=302,L]
RewriteRule ^\.htaccess\.maintenance$ - [F,L]
# ---- /Mode maintenance -------------------------------------------------------

# Redirige tout vers index.php sauf fichiers/dossiers existants
# Note IONOS : RewriteBase / + cible relative + [L,QSA] obligatoires (sinon 500)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]

# ---- Compression gzip ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json text/xml image/svg+xml
</IfModule>

# ---- Cache navigateur ----
<IfModule mod_expires.c>
    ExpiresActive On
    # JS / CSS — 1 semaine (noms de fichiers sans hash de contenu)
    ExpiresByType text/css               "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript        "access plus 1 week"
    # Images
    ExpiresByType image/png              "access plus 6 months"
    ExpiresByType image/jpeg             "access plus 6 months"
    ExpiresByType image/webp             "access plus 6 months"
    ExpiresByType image/svg+xml          "access plus 6 months"
    ExpiresByType image/gif              "access plus 6 months"
    ExpiresByType image/x-icon           "access plus 1 year"
    # Vidéos
    ExpiresByType video/webm             "access plus 6 months"
    ExpiresByType video/mp4              "access plus 6 months"
    # Fonts
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
    ExpiresByType font/ttf               "access plus 1 year"
    ExpiresByType font/otf               "access plus 1 year"
</IfModule>

# ---- Headers de sécurité HTTP ----
# X-Frame-Options intentionnellement redondant avec CSP frame-ancestors pour compatibilité navigateurs anciens (VULN-013)
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Permitted-Cross-Domain-Policies "none"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# HSTS — uniquement sur HTTPS (env=HTTPS non défini sur HTTP → header absent en local)
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
