# ============================================================
# env.example — Template des variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs manquantes.
# JAMAIS commiter le .env (contient des secrets).
# ============================================================

# ── Application ────────────────────────────────────────────
APP_ENV=development              # development | production
APP_URL=http://crabitan.local    # prod : https://crabitan.fr
APP_NAME="Château Crabitan Bellevue"

# ── Base de données ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crabitan_bellevue
DB_USER=root
DB_PASS=                         # vide en dev local XAMPP — NE PAS VERSIONNER

# ── Chiffrement colonnes sensibles (RGPD Art. 32) ──────────
# 32 octets aléatoires encodés en base64 — générer avec :
# php -r "echo base64_encode(random_bytes(32)) . PHP_EOL;"
DB_ENCRYPT_KEY=                  # NE PAS VERSIONNER

# ── Authentification JWT ───────────────────────────────────
JWT_SECRET=                      # chaîne aléatoire ≥ 32 caractères — NE PAS VERSIONNER
JWT_EXPIRY=3600                  # durée de vie du token en secondes
JWT_REFRESH_THRESHOLD=0.5        # rafraîchir quand il reste moins de X% du TTL

# ── Emails (MailHog en dev, SMTP IONOS en prod) ────────────
MAIL_HOST=localhost               # prod : smtp.ionos.fr
MAIL_PORT=1025                   # prod : 587 (STARTTLS) ou 465 (SSL)
MAIL_USER=                       # prod : adresse IONOS — NE PAS VERSIONNER
MAIL_PASS=                       # NE PAS VERSIONNER
MAIL_ENCRYPTION=                 # vide en dev, tls en prod
MAIL_FROM=noreply@crabitan.local # prod : noreply@crabitan.fr
MAIL_FROM_NAME="Château Crabitan Bellevue"
CONTACT_EMAIL=contact@crabitan.local
CONTACT_OWNER_EMAIL=test@localhost
MAINTAINER_MAIL=                 # email mainteneur — alertes IPN invalides (optionnel)

# ── OAuth Google ───────────────────────────────────────────
GOOGLE_CLIENT_ID=                # Google Cloud Console — NE PAS VERSIONNER
GOOGLE_CLIENT_SECRET=            # NE PAS VERSIONNER

# ── Paiement CA e-Transactions ─────────────────────────────
CA_SANDBOX_MODE=yes              # yes en dev/recette, no en prod
CA_FALLBACK_BASE_URL=http://crabitan.local  # prod : https://crabitan.fr
CA_PBX_SITE=                     # NE PAS VERSIONNER
CA_PBX_RANG=                     # NE PAS VERSIONNER
CA_PBX_IDENTIFIANT=              # NE PAS VERSIONNER
CA_PBX_HMAC_KEY=                 # clé HMAC CA hexadécimal — NE PAS VERSIONNER
CA_PUBKEY_PATH=config/ca-pubkey.pem

# ── APIs tierces (optionnel) ───────────────────────────────
WEATHER_API_KEY=                 # OpenWeatherMap — NE PAS VERSIONNER
TRANSLATION_API_KEY=             # NE PAS VERSIONNER
