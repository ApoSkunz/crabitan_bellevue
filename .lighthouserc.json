{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/age-gate",
        "http://localhost:8080/fr",
        "http://localhost:8080/en",
        "http://localhost:8080/fr/le-chateau",
        "http://localhost:8080/fr/savoir-faire",
        "http://localhost:8080/fr/contact",
        "http://localhost:8080/fr/mentions-legales",
        "http://localhost:8080/fr/politique-de-confidentialite",
        "http://localhost:8080/fr/conditions-generales-de-vente",
        "http://localhost:8080/fr/plan-du-site",
        "http://localhost:8080/fr/support",
        "http://localhost:8080/fr/jeux",
        "http://localhost:8080/fr/credits-medias",
        "http://localhost:8080/fr/galerie",
        "http://localhost:8080/fr/accessibilite",
        "http://localhost:8080/fr/webmaster",
        "http://localhost:8080/fr/vins",
        "http://localhost:8080/fr/vins/collection",
        "http://localhost:8080/fr/actualites",
        "http://localhost:8080/fr/mot-de-passe-oublie",
        "http://localhost:8080/fr/panier",
        "http://localhost:8080/fr/commande",
        "http://localhost:8080/fr/mon-compte",
        "http://localhost:8080/fr/mon-compte/profil",
        "http://localhost:8080/fr/mon-compte/commandes",
        "http://localhost:8080/fr/mon-compte/adresses",
        "http://localhost:8080/fr/mon-compte/factures",
        "http://localhost:8080/fr/mon-compte/favoris",
        "http://localhost:8080/fr/mon-compte/securite",
        "http://localhost:8080/fr/mon-compte/export",
        "http://localhost:8080/fr/newsletter/desabonnement",
        "http://localhost:8080/fr/newsletter/confirmation",
        "http://localhost:8080/fr/session-expiree"
      ],
      "numberOfRuns": 1,
      "puppeteerScript": "./lighthouse-auth.cjs",
      "puppeteerLaunchOptions": {
        "args": ["--no-sandbox", "--disable-dev-shm-usage"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://localhost:8080/(fr|en)/(le-chateau|savoir-faire|contact|vins|actualites|conditions-generales-de-vente|jeux|credits-medias|galerie|accessibilite).*",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:performance": ["error", { "minScore": 0.60 }],
            "categories:seo": ["error", { "minScore": 0.8 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:8080/(fr|en)$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:performance": ["error", { "minScore": 0.60 }],
            "categories:seo": ["error", { "minScore": 0.8 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:8080/(age-gate|fr/age-gate|fr/mot-de-passe-oublie|fr/panier|fr/commande|fr/mon-compte|fr/session-expiree|fr/mentions-legales|fr/politique-de-confidentialite|fr/plan-du-site|fr/webmaster|fr/support|fr/newsletter).*",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
