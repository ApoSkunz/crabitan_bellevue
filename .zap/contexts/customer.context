<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<configuration>
    <context>
        <name>Customer</name>
        <desc>Scope customer — pages publiques + espace client /mon-compte/* + panier + checkout + API</desc>
        <inscope>true</inscope>
        <!-- Pages publiques et espace client -->
        <incregexes>http://[^/]+/(fr|en)/.*</incregexes>
        <incregexes>http://[^/]+/(fr|en)$</incregexes>
        <incregexes>http://[^/]+/api/.*</incregexes>
        <!-- Exclure admin, cron, tracking, IPN, age-gate -->
        <excregexes>http://[^/]+/admin.*</excregexes>
        <excregexes>http://[^/]+/cron/.*</excregexes>
        <excregexes>http://[^/]+/track/.*</excregexes>
        <excregexes>http://[^/]+/payment/ipn.*</excregexes>
        <excregexes>http://[^/]+/age-gate.*</excregexes>
        <!-- Exclure auth Google OAuth (redirects externes) -->
        <excregexes>http://[^/]+/(fr|en)/auth/google.*</excregexes>
        <urlparser>
            <class>org.parosproxy.paros.model.SiteMapDefaultHandler</class>
            <config/>
        </urlparser>
        <postparser>
            <class>org.zaproxy.zap.model.StandardParameterParser</class>
            <config/>
        </postparser>
        <authentication>
            <type>0</type>
            <loggedin>mon-compte|Mon compte|panier</loggedin>
            <loggedout>connexion|Se connecter</loggedout>
        </authentication>
        <users/>
        <forceduser>-1</forceduser>
        <session>
            <type>0</type>
        </session>
        <authorization>
            <type>0</type>
            <basic>
                <header/>
                <body/>
                <logic>AND</logic>
                <code>-1</code>
            </basic>
        </authorization>
    </context>
</configuration>
